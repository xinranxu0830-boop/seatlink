{
  "name": "seatlink-compact-preferences",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:views": "node scripts/build-seat-views.mjs",
    "build": "npm run build:views && vite build",
    "share": "npm run build && vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "experiment:c200": "node scripts/run-c200-replay.mjs",
    "experiment:c200:publish": "node scripts/build-public-replay.mjs",
    "experiment:c200:improve": "node scripts/run-c200-replay.mjs --improvements",
    "experiment:c200:stress": "node scripts/run-c200-replay.mjs --heavy-pressure",
    "experiment:c200:density": "node scripts/run-c200-replay.mjs --density-pressure",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/verify-compact-ui.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.28.2"
  }
}
